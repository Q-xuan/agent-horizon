      "agent-engineer": {
        "threshold": 5.5,
        "topic_dedup": true
      },
      "harness-arch": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "ai-daily": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "ai-deals": {
        "threshold": 4.5,
        "topic_dedup": true
      }
    }
  },
