# OpenAI-compatible gateway (current: grok-4.6 @ https://ai.aruyx.com/v1)
OPENAI_API_KEY=

# 抓 GitHub Release 时建议带上，提高限额
GITHUB_TOKEN=

# Twitter/X via Apify. GitHub secret APIFY_TOKEN.
# Used for the follow-list (Horizon) and X 热点 search (scrape_no_rss.py → x-hot.xml).
# Free tier is enough for one daily profile scrape + one keyword search.
# Without it: follow-list is skipped and x-hot.xml is empty (other sources still run).
# APIFY_TOKEN=

# 可选：飞书 / Slack / Discord
HORIZON_WEBHOOK_URL=
